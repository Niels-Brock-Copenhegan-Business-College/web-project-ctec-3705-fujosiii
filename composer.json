{
    "name": "university/student-course-hub",
    "description": "University Student Course Hub - Slim 4 Application",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.4",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.5",
        "robmorgan/phinx": "^0.16",
        "illuminate/database": "^11.0",
        "symfony/validator": "^7.0",
        "ezyang/htmlpurifier": "^4.17"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
