<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Staff Portal{% endblock %} — {{ app_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/staff.css">
</head>
<body class="admin-body">

<a href="#staff-content" class="skip-link">Skip to main content</a>

<div class="admin-layout">

    <!-- Sidebar -->
    <aside class="admin-sidebar staff-sidebar" role="navigation" aria-label="Staff navigation">
        <div class="sidebar-brand">
            <span class="logo-icon" aria-hidden="true">◈</span>
            <span>Staff Portal</span>
        </div>

        <nav>
            <ul role="list">
                <li>
                    <a href="/staff/dashboard" class="nav-item {% if active_nav == 'dashboard' %}active{% endif %}">
                        <span class="nav-icon" aria-hidden="true">⊞</span>Dashboard
                    </a>
                </li>
                <li>
                    <a href="/staff/my-modules" class="nav-item {% if active_nav == 'modules' %}active{% endif %}">
                        <span class="nav-icon" aria-hidden="true">◫</span>My Modules
                    </a>
                </li>
                <li>
                    <a href="/staff/my-programmes" class="nav-item {% if active_nav == 'programmes' %}active{% endif %}">
                        <span class="nav-icon" aria-hidden="true">◉</span>My Programmes
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <span>{{ session.admin_name }}</span>
            <form action="/auth/logout" method="POST">
                <button type="submit" class="btn-logout">Log out</button>
            </form>
        </div>
    </aside>

    <!-- Main content -->
    <div class="admin-main">
        <header class="admin-topbar">
            <h1>{% block page_title %}Staff Portal{% endblock %}</h1>
            <a href="/" target="_blank" class="btn btn--outline btn--sm">↗ View Site</a>
        </header>

        <main id="staff-content" tabindex="-1" class="admin-content">

            {% if session.flash.success is defined %}
                <div class="alert alert--success" role="alert">✓ {{ session.flash.success }}</div>
            {% endif %}
            {% if session.flash.error is defined %}
                <div class="alert alert--error" role="alert">⚠ {{ session.flash.error }}</div>
            {% endif %}

            {% block content %}{% endblock %}
        </main>
    </div>

</div>

<script src="/js/admin.js"></script>
</body>
</html>
