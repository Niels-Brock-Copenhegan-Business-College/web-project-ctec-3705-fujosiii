{% extends 'layouts/base.twig' %}
{% block title %}Page Not Found — {{ app_name }}{% endblock %}

{% block content %}
<div class="container" style="text-align:center; padding: 6rem 1.5rem">
    <p style="font-size:6rem; line-height:1; color:var(--clr-border)">◈</p>
    <h1 style="font-family:var(--font-display); font-size:3rem; margin:.5rem 0">Page Not Found</h1>
    <p style="color:var(--clr-muted); margin-bottom:2rem">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="btn btn--primary">Back to Home</a>
    <a href="/programmes" class="btn btn--outline" style="margin-left:.75rem">Browse Programmes</a>
</div>
{% endblock %}
