<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <title>Admin Login — {{ app_name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-body">

<main class="login-wrap" aria-label="Admin login">
    <div class="login-card">
        <div class="login-brand" aria-hidden="true">◈</div>
        <h1 class="login-title">Admin Login</h1>
        <p class="login-sub">{{ app_name }}</p>

        {% if session.flash.error is defined %}
            <div class="alert alert--error" role="alert">{{ session.flash.error }}</div>
        {% endif %}

        <form action="/auth/login" method="POST" novalidate aria-label="Login form">
            <input type="hidden" name="_token" value="{{ csrf_token() }}">

            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email"
                       required autocomplete="email" autofocus aria-required="true">
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password"
                       required autocomplete="current-password" aria-required="true">
            </div>

            <button type="submit" class="btn btn--primary btn--full">Sign In</button>
        </form>
    </div>
</main>

<script src="/js/admin.js"></script>
</body>
</html>
