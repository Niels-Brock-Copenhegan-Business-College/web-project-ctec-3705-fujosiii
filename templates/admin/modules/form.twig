{% extends 'layouts/admin.twig' %}
{% set active_nav = 'modules' %}

{% block page_title %}{{ module ? 'Edit Module' : 'New Module' }}{% endblock %}

{% block content %}

<form action="{{ module ? '/admin/modules/' ~ module.id : '/admin/modules' }}"
      method="POST"
      enctype="multipart/form-data"
      novalidate
      aria-label="{{ module ? 'Edit' : 'Create' }} module form">

    <div class="form-grid">

        <!-- Left column -->
        <div class="form-col form-col--main">

            <div class="form-row">
                <div class="form-group">
                    <label for="title">Module Title <span aria-hidden="true">*</span></label>
                    <input type="text" id="title" name="title"
                           value="{{ module ? module.title|e : '' }}"
                           required aria-required="true">
                </div>
                <div class="form-group">
                    <label for="code">Module Code <span aria-hidden="true">*</span></label>
                    <input type="text" id="code" name="code"
                           value="{{ module ? module.code|e : '' }}"
                           placeholder="e.g. CS101"
                           required aria-required="true">
                </div>
                <div class="form-group">
                    <label for="credits">Credits</label>
                    <input type="number" id="credits" name="credits"
                           value="{{ module ? module.credits : 20 }}"
                           min="0" max="120">
                </div>
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" rows="5">{{ module ? module.description|e : '' }}</textarea>
            </div>

        </div>

        <!-- Right column -->
        <div class="form-col form-col--side">

            <div class="form-group">
                <label for="leader_id">Module Leader</label>
                <select id="leader_id" name="leader_id">
                    <option value="">— None —</option>
                    {% for member in staff %}
                    <option value="{{ member.id }}" {{ module and module.leader_id == member.id ? 'selected' }}>
                        {{ member.name }}
                    </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="image">Module Image</label>
                {% if module and module.image %}
                    <img src="{{ module.image }}" alt="Current image" class="current-image">
                {% endif %}
                <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp">
                <small>JPEG, PNG or WebP. Max 5MB.</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn--primary btn--full">
                    {{ module ? 'Save Changes' : 'Create Module' }}
                </button>
                <a href="/admin/modules" class="btn btn--outline btn--full">Cancel</a>
            </div>

        </div>
    </div>

</form>

{% endblock %}
