{% extends 'layouts/admin.twig' %}
{% set active_nav = 'programmes' %}

{% block page_title %}Programmes{% endblock %}

{% block content %}

<div class="toolbar">
    <a href="/admin/programmes/create" class="btn btn--primary">+ New Programme</a>
</div>

<div class="table-wrap">
    <table class="data-table" aria-label="Programmes list">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Level</th>
                <th scope="col">Leader</th>
                <th scope="col">Duration</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for programme in programmes %}
            <tr>
                <td><strong>{{ programme.title }}</strong>{% if programme.ucas_code %}<br><small>{{ programme.ucas_code }}</small>{% endif %}</td>
                <td>
                    <span class="badge badge--{{ programme.level == 'Undergraduate' ? 'ug' : 'pg' }}">
                        {{ programme.level }}
                    </span>
                </td>
                <td>{{ programme.leader ? programme.leader.name : '—' }}</td>
                <td>{{ programme.duration_years }}yr</td>
                <td>
                    <span class="status-badge status-badge--{{ programme.is_published ? 'published' : 'draft' }}">
                        {{ programme.is_published ? 'Published' : 'Draft' }}
                    </span>
                </td>
                <td class="actions">
                    <a href="/admin/programmes/{{ programme.id }}/edit" class="btn btn--sm btn--outline">Edit</a>
                    <form action="/admin/programmes/{{ programme.id }}/toggle-publish" method="POST" style="display:inline">
                        <button type="submit" class="btn btn--sm btn--{{ programme.is_published ? 'warning' : 'success' }}">
                            {{ programme.is_published ? 'Unpublish' : 'Publish' }}
                        </button>
                    </form>
                    <form action="/admin/programmes/{{ programme.id }}/delete" method="POST" style="display:inline">
                        <button type="submit" class="btn btn--sm btn--danger"
                                onclick="return confirm('Delete this programme? This cannot be undone.')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="empty-row">No programmes yet. <a href="/admin/programmes/create">Create one</a>.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
