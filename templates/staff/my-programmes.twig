{% extends 'layouts/staff.twig' %}
{% set active_nav = 'programmes' %}

{% block page_title %}My Programmes{% endblock %}

{% block content %}

{% if led_programmes|length == 0 and involved_programmes|length == 0 %}
    <div class="empty-state" role="status">
        <p>You are not currently associated with any programmes.</p>
    </div>
{% endif %}

{# Programmes they lead #}
{% if led_programmes|length > 0 %}
<section aria-labelledby="led-heading" style="margin-bottom:2.5rem">
    <h2 id="led-heading" style="font-size:1.15rem; font-weight:600; margin-bottom:1rem">
        Programmes I Lead
        <span style="color:var(--clr-muted); font-weight:400; font-size:.9rem">({{ led_programmes|length }})</span>
    </h2>

    <div style="display:flex; flex-direction:column; gap:1.25rem">
        {% for programme in led_programmes %}
        <div class="programme-detail-card">
            <div class="programme-detail-card__header">
                <div>
                    <span class="badge badge--{{ programme.level == 'Undergraduate' ? 'ug' : 'pg' }}">
                        {{ programme.level }}
                    </span>
                    <h3>
                        <a href="/programmes/{{ programme.slug }}" target="_blank">{{ programme.title }}</a>
                    </h3>
                </div>
                <span style="color:var(--clr-muted); font-size:.88rem">{{ programme.duration_years }} year{{ programme.duration_years != 1 ? 's' }}</span>
            </div>

            {% if programme.programmeModules|length > 0 %}
            <div style="margin-top:1rem">
                <p style="font-size:.85rem; font-weight:600; color:var(--clr-muted); text-transform:uppercase; letter-spacing:.04em; margin-bottom:.5rem">Modules</p>
                <div style="display:flex; flex-wrap:wrap; gap:.5rem">
                    {% for pm in programme.programmeModules %}
                    {% if pm.module %}
                    <span style="background:#f3f4f6; padding:.25rem .65rem; border-radius:4px; font-size:.85rem">
                        <code style="font-size:.8rem; color:var(--clr-primary)">{{ pm.module.code }}</code>
                        {{ pm.module.title }} <span style="color:var(--clr-muted)">(Yr {{ pm.year }})</span>
                    </span>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
</section>
{% endif %}

{# Programmes containing their modules but not led by them #}
{% if involved_programmes|length > 0 %}
<section aria-labelledby="involved-heading">
    <h2 id="involved-heading" style="font-size:1.15rem; font-weight:600; margin-bottom:.35rem">
        Programmes Containing My Modules
        <span style="color:var(--clr-muted); font-weight:400; font-size:.9rem">({{ involved_programmes|length }})</span>
    </h2>
    <p style="color:var(--clr-muted); font-size:.9rem; margin-bottom:1rem">
        These programmes include modules you lead, but are led by another staff member.
    </p>

    <div class="table-wrap">
        <table class="data-table" aria-label="Programmes containing my modules">
            <thead>
                <tr>
                    <th scope="col">Programme</th>
                    <th scope="col">Level</th>
                    <th scope="col">Programme Leader</th>
                    <th scope="col">Duration</th>
                </tr>
            </thead>
            <tbody>
                {% for programme in involved_programmes %}
                <tr>
                    <td>
                        <a href="/programmes/{{ programme.slug }}" target="_blank">{{ programme.title }}</a>
                    </td>
                    <td>
                        <span class="badge badge--{{ programme.level == 'Undergraduate' ? 'ug' : 'pg' }}">
                            {{ programme.level }}
                        </span>
                    </td>
                    <td>{{ programme.leader ? programme.leader.name : '—' }}</td>
                    <td>{{ programme.duration_years }}yr</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endif %}

{% endblock %}
